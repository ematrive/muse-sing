{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Muse Sing",
  "version": "0.7.0",
  "identifier": "app.musesing.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Muse Sing",
        "width": 1040,
        "height": 760,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Emanuele Trivella",
    "copyright": "© 2026 Emanuele Trivella",
    "category": "Music",
    "shortDescription": "Da MuseScore a OpenUtau: le voci cantano le parole",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 560,
          "height": 360
        },
        "appPosition": {
          "x": 150,
          "y": 175
        },
        "applicationFolderPosition": {
          "x": 410,
          "y": 175
        }
      },
      "entitlements": "./Entitlements.plist",
      "signingIdentity": "-"
    },
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": [
          "msng",
          "musesing"
        ],
        "name": "Progetto Muse Sing",
        "description": "Progetto Muse Sing",
        "role": "Editor",
        "rank": "Owner",
        "mimeType": "application/x-muse-sing",
        "exportedType": {
          "identifier": "app.musesing.desktop.project",
          "conformsTo": [
            "public.data",
            "public.zip-archive"
          ]
        }
      }
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFDNzc2NTE4RjI2M0ZBNTgKUldSWSttUHlHR1YzckdnMTFMaUdjSmlNYys5YW5ZZzB0dkloVFV3MjZmWitWODQzZDRIN1pXZnYK",
      "endpoints": [
        "https://github.com/ematrive/muse-sing/releases/latest/download/latest.json"
      ]
    }
  }
}
